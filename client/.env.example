VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RPC_URL=http://127.0.0.1:7545
VITE_EXPECTED_CHAIN_ID=1337
VITE_LOGS_FROM_BLOCK=0

# Optional: Pinata JWT for IPFS uploads in admin emission flow
VITE_PINATA_JWT=
# -----------------------------------------------------------------------------
# Copiez ce fichier :  client/.env.example  →  client/.env
# Le vrai .env est ignoré par Git — ne commitez jamais vos clés ou adresses prod.
# -----------------------------------------------------------------------------

# Obligatoire — adresse du contrat DiplomaRegistry après `truffle migrate`
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Recommandé — lecture blockchain sans MetaMask (Ganache ou RPC public testnet)
# Exemple Ganache local :
# VITE_RPC_URL=http://127.0.0.1:7545
# Exemple Sepolia (remplacer par votre URL Infura/Alchemy) :
# VITE_RPC_URL=https://sepolia.infura.io/v3/VOTRE_CLE

# Optionnel — rappel UI si le réseau MetaMask ne correspond pas
# Ganache courant : 1337 ou 5777  |  Sepolia : 11155111
# VITE_EXPECTED_CHAIN_ID=1337

# Optionnel — bloc de départ pour le scan des événements (économise des appels RPC)
# VITE_LOGS_FROM_BLOCK=0

# Optionnel — JWT Pinata pour upload IPFS réel (sinon mode démo / CID local)
# VITE_PINATA_JWT=
